<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="in.co.rays.project_3.dto">

	<class name="DriverDTO" table="ST_DRIVER">

		<id name="id" type="java.lang.Long">
			<column name="ID" />
			<generator class="increment" />
		</id>

		<property name="driverCode" type="java.lang.String">
			<column name="DRIVER_CODE" unique="true" />
		</property>

		<property name="driverName" type="java.lang.String">
			<column name="DRIVER_NAME" />
		</property>

		<property name="licenseNumber" type="java.lang.String">
			<column name="LICENSE_NUMBER" />
		</property>

		<property name="contactNumber" type="java.lang.String">
			<column name="CONTACT_NUMBER" />
		</property>

		<property name="createdBy" type="java.lang.String" length="50">
			<column name="CREATED_BY" />
		</property>

		<property name="modifiedBy" type="java.lang.String" length="50">
			<column name="MODIFIED_BY" />
		</property>

		<property name="createdDatetime" type="java.sql.Timestamp">
			<column name="CREATED_DATETIME" />
		</property>

		<property name="modifiedDatetime" type="java.sql.Timestamp">
			<column name="MODIFIED_DATETIME" />
		</property>

	</class>

</hibernate-mapping>